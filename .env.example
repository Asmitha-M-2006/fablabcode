DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# HackClub AI (priority provider — free, supports 100+ models)
HACKCLUB_API_KEY=<SECRET>
HACKCLUB_MODEL=anthropic/claude-opus-4-5
HACKCLUB_ENDPOINT=https://ai.hackclub.com/proxy/v1/chat/completions

# Gemini (fallback)
GEMINI_API_KEY=<SECRET>
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (fallback)
OPENAI_API_KEY=<SECRET>
OPENAI_MODEL=gpt-4o

# Optional overrides
AI_PROVIDER=hackclub
AI_REQUEST_TIMEOUT_MS=30000
